    <geom name="s3_strip" type="box" pos="0.0803747 0.220828 0.21" size="0.035 0.04 0.03" euler="0 0 1.22173" material="station_mat" contype="0" conaffinity="0"/>
    <geom name="s3_strip_tag" type="box" pos="0.067378 0.185119 0.2268" size="0.0015 0.0125 0.0125" euler="0 0 1.22173" material="tag_mat" contype="0" conaffinity="0"/>
