    <geom name="bench" type="plane" size="1.2 1.2 0.05" material="bench_mat"/>

    <!-- S4 CRIMP: the press. Placed first; everything else is derived from it. -->
    <geom name="press_base" type="box"
      pos="-0.16617 0.16617 0.03"
      size="0.105 0.105 0.03"
      euler="0 0 2.35619" material="press_mat" contype="0" conaffinity="0"/>
    <geom name="press_column" type="box"
      pos="-0.207006 0.207006 0.29"
