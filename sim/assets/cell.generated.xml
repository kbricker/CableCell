                range="-0.01 0.01"
                damping="8"/>
              <geom name="cross_carriage" type="box" pos="0 0 0"
                size="0.012 0.016 0.007" material="arm_mat"
                contype="0" conaffinity="0"/>

              <body name="wrist" pos="0 0 0">
                <joint name="W" type="hinge" axis="1 0 0" range="0 3.14159"
                  damping="6"/>
                <!-- Comb: 3 channels at 8 mm pitch, guiding not clamping. -->
                <geom name="comb_body" type="mesh" mesh="comb_mesh"
                  pos="-0.004 0 -0.006" material="comb_mat"
                  contype="0" conaffinity="0"/>
                <site name="comb_tip" pos="0.028 0 0"
                  size="0.003" rgba="0.2 1 0.4 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="Z_act" joint="Z" kp="800" ctrlrange="0 0.1"/>
    <position name="T_act" joint="T" kp="200"
      ctrlrange="-2.35619 2.35619"/>
    <position name="R_act" joint="R" kp="400" ctrlrange="0 0.08"/>
    <position name="S_act" joint="S" kp="200"
      ctrlrange="-0.01 0.01"/>
    <position name="W_act" joint="W" kp="100" ctrlrange="0 3.14159"/>
  </actuator>
</mujoco>
