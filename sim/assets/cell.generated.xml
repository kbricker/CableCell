    <connect name="web_1_5" body1="rib_1_5" body2="rib_2_5" anchor="0 0.0007 0" solref="0.004 1"/>
    <connect name="web_1_6" body1="rib_1_6" body2="rib_2_6" anchor="0 0.0007 0" solref="0.004 1"/>
