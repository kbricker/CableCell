    <!-- S1's spool + hanger + dancer, off-deck outboard of station 1. -->
    <geom name="spool_hub" type="cylinder" pos="0.29 0 0.33" size="0.03 0.0125" euler="1.5708 0 0" material="spool_mat" contype="0" conaffinity="0"/>
