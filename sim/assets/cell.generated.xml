    <geom name="deck" type="cylinder"
      pos="0 0 0.175"
      size="0.28 0.005"
      material="deck_mat" contype="0" conaffinity="0"/>
    <geom name="frame_ring" type="cylinder"
      pos="0 0 0.085"
